{
  "schemaVersion": 1,
  "id": "cobblepastureoptimizer",
  "version": "${version}",
  "name": "CobblePasture Optimizer",
  "description": "Optimiza los Pasture de Cobblemon virtualizando Pokémon físicos y conservando los drops de Pasture Loot; compatible con servidor dedicado, LAN y servidor integrado de singleplayer.",
  "authors": [
    "andrewBristowx"
  ],
  "license": "ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.andrewbristowx.cobblepastureoptimizer.CobblePastureOptimizer"
    ]
  },
  "mixins": [
    "cobblepastureoptimizer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "cobblemon": "1.7.3+1.21.1",
    "pasture-loot": "1.0.5+1.21.1"
  }
}
